#!/usr/bin/env bash
#
# ssl-check — скачивает SSL-сертификаты серверов и проверяет срок действия.
#
# Список серверов хранится отдельно, в servers.txt (рядом со скриптом):
#     домен  IP-адрес  [порт]
# Если файла нет — скрипт создаёт его сам.
#
# Использование:
#     ./ssl-check                 интерактивное меню
#     ./ssl-check --check         сразу проверить все серверы (для cron/CI)
#     ./ssl-check [--check] файл  использовать другой файл списка
#
# Код возврата в режиме --check: 0 — всё в порядке, 1 — есть предупреждения или ошибки.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE=menu
LIST_ARG=""
for arg in "$@"; do
  case "$arg" in
    --check|-c) MODE=check ;;
    -h|--help)  sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)          LIST_ARG="$arg" ;;
  esac
done
LIST_FILE="${LIST_ARG:-$SCRIPT_DIR/servers.txt}"
CERT_DIR="$SCRIPT_DIR/certs"
TIMEOUT=10        # секунд на подключение к серверу
WARN_DAYS=15      # предупреждать, если до окончания срока осталось меньше

# ── Оформление ──────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  C_ORANGE=$'\033[38;5;173m'; C_GRAY=$'\033[38;5;244m'; C_GREEN=$'\033[38;5;71m'
  C_YELLOW=$'\033[38;5;214m'; C_RED=$'\033[38;5;167m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
  IS_TTY=1
else
  C_ORANGE=; C_GRAY=; C_GREEN=; C_YELLOW=; C_RED=; C_BOLD=; C_RESET=; IS_TTY=0
fi
SPIN_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

trap '[ "$IS_TTY" = 1 ] && printf "\033[?25h"' EXIT
trap 'printf "\n%s  Прервано пользователем.%s\n" "$C_GRAY" "$C_RESET"; exit 130' INT

bullet() { printf '%s●%s %s\n' "$C_ORANGE" "$C_RESET" "$1"; }
sub()    { printf '  %s⎿%s  %s\n' "$C_GRAY" "$C_RESET" "$1"; }
note()   { printf '  %s%s%s\n' "$C_GRAY" "$1" "$C_RESET"; }

pad() { # pad "текст" ширина — дополняет пробелами справа
  local s="$1" w="$2" n
  n=$(( w - ${#s} )); printf '%s' "$s"
  while [ "$n" -gt 0 ]; do printf ' '; n=$((n - 1)); done
}

header() {
  printf '\n%s╭──────────────────────────────────────────────╮%s\n' "$C_ORANGE" "$C_RESET"
  printf '%s│%s %s✻%s %sПроверка SSL-сертификатов%s                  %s│%s\n' \
    "$C_ORANGE" "$C_RESET" "$C_ORANGE" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_ORANGE" "$C_RESET"
  printf '%s│%s   %sСрок действия · IP сервера · загрузка .pem%s %s│%s\n' \
    "$C_ORANGE" "$C_RESET" "$C_GRAY" "$C_RESET" "$C_ORANGE" "$C_RESET"
  printf '%s╰──────────────────────────────────────────────╯%s\n\n' "$C_ORANGE" "$C_RESET"
}

# ── Проверка окружения ──────────────────────────────────────────────────────
if ! command -v openssl >/dev/null 2>&1; then
  printf '%s✗ Не найден openssl. Установите его и повторите запуск.%s\n' "$C_RED" "$C_RESET"
  exit 2
fi

if date --version >/dev/null 2>&1; then DATE_GNU=1; else DATE_GNU=0; fi

# ── Утилиты ─────────────────────────────────────────────────────────────────
valid_ip() {
  local ip="$1" o
  if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    local IFS=.; for o in $ip; do [ "$o" -le 255 ] || return 1; done
    return 0
  fi
  [[ "$ip" =~ ^[0-9a-fA-F:]+$ && "$ip" == *:* ]]   # упрощённая проверка IPv6
}

resolve_dns() {
  local d="$1" r=""
  if command -v dig >/dev/null 2>&1; then
    r=$(dig +short +time=3 +tries=1 "$d" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1)
  fi
  if [ -z "$r" ] && command -v dscacheutil >/dev/null 2>&1; then
    r=$(dscacheutil -q host -a name "$d" 2>/dev/null | awk '/^ip_address:/{print $2; exit}')
  fi
  if [ -z "$r" ] && command -v getent >/dev/null 2>&1; then
    r=$(getent ahostsv4 "$d" 2>/dev/null | awk 'NR==1{print $1}')
  fi
  printf '%s' "$r"
}

# Все IP-адреса домена по DNS (по одному в строке).
resolve_all() {
  local d="$1" r=""
  if command -v dig >/dev/null 2>&1; then
    r=$(dig +short +time=3 +tries=1 "$d" A "$d" AAAA 2>/dev/null | grep -E '^[0-9a-fA-F.:]+$')
  fi
  if [ -z "$r" ] && command -v dscacheutil >/dev/null 2>&1; then
    r=$(dscacheutil -q host -a name "$d" 2>/dev/null | awk '/^(ip|ipv6)_address:/{print $2}')
  fi
  if [ -z "$r" ] && command -v getent >/dev/null 2>&1; then
    r=$(getent ahosts "$d" 2>/dev/null | awk '{print $1}' | sort -u)
  fi
  printf '%s\n' "$r"
}

epoch_from_openssl_date() { # "Mar  5 12:00:00 2027 GMT" -> epoch
  if [ "$DATE_GNU" = 1 ]; then date -d "$1" +%s 2>/dev/null
  else TZ=UTC date -j -f "%b %e %H:%M:%S %Y %Z" "$1" +%s 2>/dev/null; fi
}

fmt_date() { # epoch -> дд.мм.гггг
  if [ "$DATE_GNU" = 1 ]; then date -d "@$1" +%d.%m.%Y
  else date -r "$1" +%d.%m.%Y; fi
}

# Ждёт фоновый процесс, рисуя спиннер. Возвращает 124 при таймауте.
wait_spin() {
  local pid="$1" label="$2" i=0 max=$(( TIMEOUT * 10 )) rc
  [ "$IS_TTY" = 1 ] && printf '\033[?25l'
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$i" -ge "$max" ]; then
      kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
      [ "$IS_TTY" = 1 ] && printf '\r\033[K\033[?25h'
      return 124
    fi
    if [ "$IS_TTY" = 1 ]; then
      printf '\r  %s%s%s %s%s%s' "$C_ORANGE" "${SPIN_FRAMES[$(( i % 10 ))]}" "$C_RESET" "$C_GRAY" "$label" "$C_RESET"
    fi
    sleep 0.1; i=$((i + 1))
  done
  wait "$pid"; rc=$?
  [ "$IS_TTY" = 1 ] && printf '\r\033[K\033[?25h'
  return $rc
}

# Записывает найденный IP в строку файла, где указан только домен.
save_ip() {
  local domain="$1" ip="$2"
  awk -v d="$domain" -v ip="$ip" '
    { line=$0; c=""
      if (match(line, /#.*/)) { c=" " substr(line, RSTART); line=substr(line, 1, RSTART-1) }
      n=split(line, a, " ")
      if (n==1 && a[1]==d) print d " " ip c; else print $0 }
  ' "$LIST_FILE" > "$LIST_FILE.tmp" && mv "$LIST_FILE.tmp" "$LIST_FILE"
}

# Спрашивает IP у пользователя. Результат — в ASKED_IP. Код 1 — пропуск.
ask_ip() {
  local domain="$1" dns reply
  dns=$(resolve_dns "$domain")
  printf '%s?%s  Для %s%s%s не задан IP-адрес.\n' "$C_ORANGE" "$C_RESET" "$C_BOLD" "$domain" "$C_RESET"
  while true; do
    if [ -n "$dns" ]; then
      printf '  %s⎿%s  Введите IP %s(Enter — из DNS: %s, s — пропустить)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$dns" "$C_RESET"
    else
      printf '  %s⎿%s  Введите IP %s(s — пропустить)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$C_RESET"
    fi
    if ! read -r reply; then printf '\n'; return 1; fi
    case "$reply" in
      s|S|с|С) return 1 ;;
      "") [ -n "$dns" ] && reply="$dns" ;;
    esac
    if valid_ip "$reply"; then ASKED_IP="$reply"; return 0; fi
    printf '  %s⎿%s  %sНекорректный IP-адрес, попробуйте ещё раз.%s\n' "$C_GRAY" "$C_RESET" "$C_RED" "$C_RESET"
  done
}

# ── Результаты ──────────────────────────────────────────────────────────────
R_DOM=(); R_IP=(); R_END=(); R_LEFT=(); R_HTTP=(); R_STAT=(); R_LVL=()
HTTP_RES="—"
add_row() { R_DOM+=("$1"); R_IP+=("$2"); R_END+=("$3"); R_LEFT+=("$4"); R_HTTP+=("$HTTP_RES"); R_STAT+=("$5"); R_LVL+=("$6"); HTTP_RES="—"; }

check_server() {
  local domain="$1" ip="$2" port="$3"
  local target safe pem out err rc

  safe="${domain//[^A-Za-z0-9._-]/_}"
  pem="$CERT_DIR/$safe.pem"
  out=$(mktemp); err=$(mktemp)

  bullet "${C_BOLD}${domain}${C_RESET}  ${C_GRAY}${ip}:${port}${C_RESET}"

  # IP из списка должен совпадать с DNS-записями домена
  local dns_ips
  dns_ips=$(resolve_all "$domain")
  if [ -n "$dns_ips" ] && ! printf '%s\n' "$dns_ips" | grep -qix -- "$ip"; then
    sub "${C_RED}Неправильный IP: ${ip} не совпадает с DNS ($(printf '%s' "$dns_ips" | head -n3 | paste -sd, - | sed 's/,/, /g')) ✗${C_RESET}"
    add_row "$domain" "$ip" "—" "—" "Неправильный IP" 2
    rm -f "$out" "$err"; echo; return
  fi
  [ -z "$dns_ips" ] && sub "${C_GRAY}DNS не отвечает — соответствие IP не проверено${C_RESET}"

  if [[ "$ip" == *:* ]]; then target="[$ip]:$port"; else target="$ip:$port"; fi
  openssl s_client -connect "$target" -servername "$domain" </dev/null >"$out" 2>"$err" &
  wait_spin $! "Подключаюсь и скачиваю сертификат…"
  rc=$?

  if [ "$rc" = 124 ]; then
    sub "${C_RED}Таймаут: сервер не ответил за ${TIMEOUT} с${C_RESET}"
    add_row "$domain" "$ip" "—" "—" "Таймаут" 2
    rm -f "$out" "$err"; echo; return
  fi

  mkdir -p "$CERT_DIR"
  if ! openssl x509 -outform PEM <"$out" >"$pem" 2>/dev/null || [ ! -s "$pem" ]; then
    local reason
    reason=$(grep -m1 -iE 'refused|timed out|unreachable|no route|error|failure' "$err")
    sub "${C_RED}Не удалось получить сертификат${C_RESET}${reason:+ ${C_GRAY}($reason)${C_RESET}}"
    add_row "$domain" "$ip" "—" "—" "Ошибка" 2
    rm -f "$pem" "$out" "$err"; echo; return
  fi
  sub "Сертификат сохранён: ${C_GRAY}${pem#"$SCRIPT_DIR"/}${C_RESET}"

  local issuer enddate end_epoch now left end_fmt
  issuer=$(openssl x509 -in "$pem" -noout -issuer 2>/dev/null | sed -n 's/.*CN *= *//p' | sed 's/[,\/].*//')
  [ -z "$issuer" ] && issuer=$(openssl x509 -in "$pem" -noout -issuer 2>/dev/null | sed 's/^issuer= *//')
  sub "Издатель: ${issuer:-неизвестно}"

  enddate=$(openssl x509 -in "$pem" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')
  end_epoch=$(epoch_from_openssl_date "$enddate")
  if [ -z "$end_epoch" ]; then
    sub "${C_RED}Не удалось разобрать дату окончания: ${enddate}${C_RESET}"
    add_row "$domain" "$ip" "—" "—" "Ошибка даты" 2
    rm -f "$out" "$err"; echo; return
  fi
  now=$(date +%s)
  left=$(( (end_epoch - now) / 86400 ))
  end_fmt=$(fmt_date "$end_epoch")

  local level stat colour
  if [ "$end_epoch" -le "$now" ]; then
    level=2; stat="Истёк"; colour="$C_RED"
    sub "Действует до: ${end_fmt} — ${colour}истёк $(( -left )) дн. назад ✗${C_RESET}"
    left="$left"
  elif [ "$left" -lt "$WARN_DAYS" ]; then
    level=1; stat="Скоро истекает"; colour="$C_YELLOW"
    sub "Действует до: ${end_fmt} — ${colour}осталось ${left} дн. ⚠${C_RESET}"
  else
    level=0; stat="OK"; colour="$C_GREEN"
    sub "Действует до: ${end_fmt} — ${colour}осталось ${left} дн. ✓${C_RESET}"
  fi

  local host_check
  host_check=$(openssl x509 -in "$pem" -noout -checkhost "$domain" 2>/dev/null)
  if [[ "$host_check" == *"does NOT match"* ]]; then
    sub "${C_YELLOW}Сертификат не выдан для домена ${domain} ⚠${C_RESET}"
    [ "$level" -lt 1 ] && { level=1; stat="Чужой домен"; }
  fi

  # HTTP-проверка: сервер должен вернуть 200 (редиректы не обрабатываются)
  if command -v curl >/dev/null 2>&1; then
    local code="" http_out
    http_out=$(mktemp)
    curl -sk -o /dev/null -w '%{http_code}' --max-time "$TIMEOUT" \
      --resolve "${domain}:${port}:${ip}" "https://${domain}:${port}/" >"$http_out" 2>/dev/null &
    wait_spin $! "Проверяю ответ сервера (HTTP)…"
    code=$(cat "$http_out"); rm -f "$http_out"
    if [ "$code" = "200" ]; then
      HTTP_RES="200"
      sub "Ответ сервера: ${C_GREEN}HTTP 200 ✓${C_RESET}"
    else
      if [ -z "$code" ] || [ "$code" = "000" ]; then
        HTTP_RES="нет"; sub "Ответ сервера: ${C_RED}нет ответа ✗${C_RESET}"
        [ "$level" -lt 2 ] && stat="Нет ответа HTTP"
      else
        HTTP_RES="$code"; sub "Ответ сервера: ${C_RED}HTTP ${code}, ожидался 200 ✗${C_RESET}"
        [ "$level" -lt 2 ] && stat="HTTP ${code}"
      fi
      level=2
    fi
  else
    sub "${C_GRAY}curl не найден — HTTP-проверка пропущена${C_RESET}"
  fi

  add_row "$domain" "$ip" "$end_fmt" "$left" "$stat" "$level"
  rm -f "$out" "$err"; echo
}

summary() {
  local n=${#R_DOM[@]} i colour mark ok=0 warn=0 fail=0
  [ "$n" -eq 0 ] && return

  bullet "${C_BOLD}Итоги${C_RESET}"
  printf '  %s%s  %s  %s  %s  %s  %s%s\n' "$C_GRAY" "$(pad "Домен" 28)" "$(pad "IP" 16)" "$(pad "До" 11)" "$(pad "Дней" 6)" "$(pad "HTTP" 6)" "Статус" "$C_RESET"
  for (( i = 0; i < n; i++ )); do
    case "${R_LVL[$i]}" in
      0) colour="$C_GREEN";  mark="✓"; ok=$((ok + 1)) ;;
      1) colour="$C_YELLOW"; mark="⚠"; warn=$((warn + 1)) ;;
      *) colour="$C_RED";    mark="✗"; fail=$((fail + 1)) ;;
    esac
    printf '  %s  %s  %s  %s  %s  %s%s %s%s\n' \
      "$(pad "${R_DOM[$i]}" 28)" "$(pad "${R_IP[$i]}" 16)" "$(pad "${R_END[$i]}" 11)" \
      "$(pad "${R_LEFT[$i]}" 6)" "$(pad "${R_HTTP[$i]}" 6)" "$colour" "$mark" "${R_STAT[$i]}" "$C_RESET"
  done

  printf '\n%s✻%s Проверено: %s%d%s · %sв порядке: %d%s · %sпредупреждений: %d%s · %sошибок: %d%s\n\n' \
    "$C_ORANGE" "$C_RESET" "$C_BOLD" "$n" "$C_RESET" \
    "$C_GREEN" "$ok" "$C_RESET" "$C_YELLOW" "$warn" "$C_RESET" "$C_RED" "$fail" "$C_RESET"

  [ $(( warn + fail )) -eq 0 ]
}

# ── Работа со списком ───────────────────────────────────────────────────────
ensure_list_file() {
  [ -f "$LIST_FILE" ] && return 0
  cat >"$LIST_FILE" <<'EOF'
# Список серверов для ssl-check
# Формат: домен IP-адрес [порт]
# Если IP не указан — скрипт спросит его при проверке и сохранит в этот файл.
# Порт по умолчанию — 443. Строки, начинающиеся с #, игнорируются.

EOF
  bullet "Файл списка не найден — создан новый"
  sub "${C_GRAY}${LIST_FILE}${C_RESET}"
  echo
}

# Записи списка в виде: номер|домен|ip|порт
list_entries() {
  awk '{ line=$0; sub(/#.*/, "", line); n=split(line, a, " ")
         if (n > 0) { i++; print i "|" a[1] "|" a[2] "|" a[3] } }' "$LIST_FILE"
}

# ── Пункт 1: проверка всех серверов ─────────────────────────────────────────
run_check_all() {
  R_DOM=(); R_IP=(); R_END=(); R_LEFT=(); R_HTTP=(); R_STAT=(); R_LVL=()

  bullet "Читаю список серверов"
  sub "${C_GRAY}${LIST_FILE}${C_RESET}"
  echo

  local line domain ip port _
  while IFS= read -r line <&3 || [ -n "$line" ]; do
    line="${line%%#*}"
    read -r domain ip port _ <<<"$line"
    [ -z "$domain" ] && continue
    port="${port:-443}"

    if [ -z "$ip" ]; then
      if ask_ip "$domain"; then
        ip="$ASKED_IP"
        save_ip "$domain" "$ip"
        sub "${C_GREEN}IP ${ip} сохранён в ${LIST_FILE##*/}${C_RESET}"
        echo
      else
        sub "${C_YELLOW}Пропущено${C_RESET}"
        add_row "$domain" "—" "—" "—" "Нет IP" 1
        echo
        continue
      fi
    elif ! valid_ip "$ip"; then
      bullet "${C_BOLD}${domain}${C_RESET}"
      sub "${C_RED}Некорректный IP в списке: ${ip}${C_RESET}"
      add_row "$domain" "$ip" "—" "—" "Неверный IP" 2
      echo
      continue
    fi

    check_server "$domain" "$ip" "$port"
  done 3<"$LIST_FILE"

  if [ "${#R_DOM[@]}" -eq 0 ]; then
    note "Список пуст. Добавьте сервер через пункт меню «Добавить сервер»."
    echo
    return 0
  fi
  summary
}

# ── Пункт 2: добавление сервера ─────────────────────────────────────────────
add_server() {
  local domain ip="" port reply dns
  bullet "${C_BOLD}Добавление сервера${C_RESET}"

  while true; do
    printf '  %s⎿%s  Домен %s(Enter — отмена)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$C_RESET"
    read -r domain || { echo; return; }
    [ -z "$domain" ] && { sub "${C_GRAY}Отменено${C_RESET}"; echo; return; }
    domain=$(printf '%s' "$domain" | tr 'A-Z' 'a-z')
    if ! [[ "$domain" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]]; then
      sub "${C_RED}Некорректное имя домена, попробуйте ещё раз.${C_RESET}"; continue
    fi
    if list_entries | cut -d'|' -f2 | grep -qx -- "$domain"; then
      sub "${C_RED}Домен ${domain} уже есть в списке.${C_RESET}"; continue
    fi
    break
  done

  dns=$(resolve_dns "$domain")
  while true; do
    if [ -n "$dns" ]; then
      printf '  %s⎿%s  IP-адрес %s(Enter — из DNS: %s, s — задать позже)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$dns" "$C_RESET"
    else
      printf '  %s⎿%s  IP-адрес %s(Enter — задать позже)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$C_RESET"
    fi
    read -r reply || { echo; return; }
    case "$reply" in
      s|S|с|С) ip=""; break ;;
      "") ip="$dns"; break ;;
    esac
    if valid_ip "$reply"; then ip="$reply"; break; fi
    sub "${C_RED}Некорректный IP-адрес, попробуйте ещё раз.${C_RESET}"
  done

  port=""
  if [ -n "$ip" ]; then
    while true; do
      printf '  %s⎿%s  Порт %s(Enter — 443)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$C_RESET"
      read -r port || { echo; return; }
      [ -z "$port" ] && break
      if [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; then
        [ "$port" = 443 ] && port=""
        break
      fi
      sub "${C_RED}Порт должен быть числом от 1 до 65535.${C_RESET}"
    done
  fi

  # файл должен заканчиваться переводом строки
  [ -s "$LIST_FILE" ] && [ -n "$(tail -c1 "$LIST_FILE")" ] && echo >>"$LIST_FILE"
  echo "$domain${ip:+ $ip}${port:+ $port}" >>"$LIST_FILE"
  sub "${C_GREEN}Сервер ${domain}${ip:+ ($ip)} добавлен в ${LIST_FILE##*/} ✓${C_RESET}"
  [ -z "$ip" ] && sub "${C_GRAY}IP будет запрошен при проверке.${C_RESET}"
  echo
}

# ── Пункт 3: удаление сервера ───────────────────────────────────────────────
remove_server() {
  local entries n num dom ip port reply confirm
  bullet "${C_BOLD}Удаление сервера${C_RESET}"
  entries=$(list_entries)
  if [ -z "$entries" ]; then
    sub "${C_GRAY}Список пуст — удалять нечего.${C_RESET}"; echo; return
  fi
  while IFS='|' read -r num dom ip port; do
    printf '  %s⎿%s  %s%2s%s  %s  %s%s%s\n' "$C_GRAY" "$C_RESET" "$C_ORANGE" "$num" "$C_RESET" \
      "$(pad "$dom" 28)" "$C_GRAY" "${ip:-IP не задан}${port:+:$port}" "$C_RESET"
  done <<<"$entries"
  n=$(printf '%s\n' "$entries" | wc -l | tr -d ' ')

  while true; do
    printf '  %s⎿%s  Номер сервера %s(Enter — отмена)%s: ' "$C_GRAY" "$C_RESET" "$C_GRAY" "$C_RESET"
    read -r reply || { echo; return; }
    [ -z "$reply" ] && { sub "${C_GRAY}Отменено${C_RESET}"; echo; return; }
    if [[ "$reply" =~ ^[0-9]+$ ]] && [ "$reply" -ge 1 ] && [ "$reply" -le "$n" ]; then break; fi
    sub "${C_RED}Введите число от 1 до ${n}.${C_RESET}"
  done

  dom=$(printf '%s\n' "$entries" | awk -F'|' -v k="$reply" '$1==k{print $2}')
  printf '  %s⎿%s  Удалить %s%s%s? %s(y/n)%s: ' "$C_GRAY" "$C_RESET" "$C_BOLD" "$dom" "$C_RESET" "$C_GRAY" "$C_RESET"
  read -r confirm || { echo; return; }
  case "$confirm" in
    y|Y|д|Д|да|Да|yes) ;;
    *) sub "${C_GRAY}Отменено${C_RESET}"; echo; return ;;
  esac

  awk -v k="$reply" '{ line=$0; sub(/#.*/, "", line); n=split(line, a, " ")
        if (n > 0 && ++i == k) next; print $0 }' "$LIST_FILE" >"$LIST_FILE.tmp" \
    && mv "$LIST_FILE.tmp" "$LIST_FILE"
  sub "${C_GREEN}Сервер ${dom} удалён из ${LIST_FILE##*/} ✓${C_RESET}"
  echo
}

# ── Меню ────────────────────────────────────────────────────────────────────
menu() {
  local choice
  while true; do
    ensure_list_file
    bullet "${C_BOLD}Что сделать?${C_RESET}"
    sub "${C_ORANGE}1${C_RESET}  Проверка всех серверов"
    sub "${C_ORANGE}2${C_RESET}  Добавить сервер"
    sub "${C_ORANGE}3${C_RESET}  Удалить сервер"
    sub "${C_ORANGE}4${C_RESET}  Выйти"
    printf '\n%s?%s  Выбор %s[1-4]%s: ' "$C_ORANGE" "$C_RESET" "$C_GRAY" "$C_RESET"
    read -r choice || { echo; return; }
    echo
    case "$choice" in
      1) run_check_all ;;
      2) add_server ;;
      3) remove_server ;;
      4|q|Q) printf '%s✻%s До встречи!\n\n' "$C_ORANGE" "$C_RESET"; return ;;
      *) printf '  %sВведите число от 1 до 4.%s\n\n' "$C_RED" "$C_RESET" ;;
    esac
  done
}

# ── Запуск ──────────────────────────────────────────────────────────────────
header
ensure_list_file

if [ "$MODE" = check ]; then
  run_check_all
  exit $?
fi

menu
exit 0
